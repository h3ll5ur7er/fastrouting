(pcb fine-pitch.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "KiCad's Pcbnew") (host_version "10.0.7"))
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  40000 -30000  0 -30000  0 0  40000 0  40000 -30000))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 200))
  )
  (placement
    (component "test:TSSOP-16"
      (place U1 20000 -15000 front 0)
    )
    (component "test:Header-8"
      (place J1 4000 -6110 front 0)
      (place J2 36000 -6110 front 0)
    )
  )
  (library
    (image "test:TSSOP-16"
      (pin Rect[T]Pad_1200x300_um 1 -2900 2275)
      (pin Rect[T]Pad_1200x300_um 2 -2900 1625)
      (pin Rect[T]Pad_1200x300_um 3 -2900 975)
      (pin Rect[T]Pad_1200x300_um 4 -2900 325)
      (pin Rect[T]Pad_1200x300_um 5 -2900 -325)
      (pin Rect[T]Pad_1200x300_um 6 -2900 -975)
      (pin Rect[T]Pad_1200x300_um 7 -2900 -1625)
      (pin Rect[T]Pad_1200x300_um 8 -2900 -2275)
      (pin Rect[T]Pad_1200x300_um 9 2900 -2275)
      (pin Rect[T]Pad_1200x300_um 10 2900 -1625)
      (pin Rect[T]Pad_1200x300_um 11 2900 -975)
      (pin Rect[T]Pad_1200x300_um 12 2900 -325)
      (pin Rect[T]Pad_1200x300_um 13 2900 325)
      (pin Rect[T]Pad_1200x300_um 14 2900 975)
      (pin Rect[T]Pad_1200x300_um 15 2900 1625)
      (pin Rect[T]Pad_1200x300_um 16 2900 2275)
    )
    (image "test:Header-8"
      (pin Round[A]Pad_1700_um 1 0 0)
      (pin Round[A]Pad_1700_um 2 0 -2540)
      (pin Round[A]Pad_1700_um 3 0 -5080)
      (pin Round[A]Pad_1700_um 4 0 -7620)
      (pin Round[A]Pad_1700_um 5 0 -10160)
      (pin Round[A]Pad_1700_um 6 0 -12700)
      (pin Round[A]Pad_1700_um 7 0 -15240)
      (pin Round[A]Pad_1700_um 8 0 -17780)
    )
    (padstack Rect[T]Pad_1200x300_um (shape (rect F.Cu -600 -150 600 150)) (attach off))
    (padstack Round[A]Pad_1700_um (shape (circle F.Cu 1700)) (shape (circle B.Cu 1700)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off))
  )
  (network
    (net L1 (pins U1-1 J1-1))
    (net R1 (pins U1-9 J2-8))
    (net L2 (pins U1-2 J1-2))
    (net R2 (pins U1-10 J2-7))
    (net L3 (pins U1-3 J1-3))
    (net R3 (pins U1-11 J2-6))
    (net L4 (pins U1-4 J1-4))
    (net R4 (pins U1-12 J2-5))
    (net L5 (pins U1-5 J1-5))
    (net R5 (pins U1-13 J2-4))
    (net L6 (pins U1-6 J1-6))
    (net R6 (pins U1-14 J2-3))
    (net L7 (pins U1-7 J1-7))
    (net R7 (pins U1-15 J2-2))
    (net L8 (pins U1-8 J1-8))
    (net R8 (pins U1-16 J2-1))
  )
  (wiring)
)
