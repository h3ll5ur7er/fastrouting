(pcb enclosed-pad.dsn
  (parser (string_quote ") (space_in_quoted_tokens on) (host_cad "KiCad's Pcbnew") (host_version "10.0.7"))
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  30000 -20000  0 -20000  0 0  30000 0  30000 -20000))
    (keepout "" (rect signal 6000 -14000 14000 -13500))
    (keepout "" (rect signal 6000 -6500 14000 -6000))
    (keepout "" (rect signal 6000 -14000 6500 -6000))
    (keepout "" (rect signal 13500 -14000 14000 -6000))
    (via "Via[0-1]_600:300_um")
    (rule (width 200) (clearance 200))
  )
  (placement
    (component "test:R"
      (place R1 10000 -10000 front 0)
      (place R2 25000 -10000 front 0)
    )
  )
  (library
    (image "test:R"
      (pin Rect[T]Pad_1000x1200_um 1 -1000 0)
      (pin Rect[T]Pad_1000x1200_um 2 1000 0)
    )
    (padstack Rect[T]Pad_1000x1200_um (shape (rect F.Cu -500 -600 500 600)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off))
  )
  (network
    (net Inside (pins R1-2 R2-1))
  )
  (wiring)
)
